# Database - Supabase
# DATABASE_URL → Settings > Database > Connection pooling > Transaction mode (port 6543)
# DIRECT_URL   → Settings > Database > Connection string > URI (port 5432)
DATABASE_URL="postgresql://postgres.xxxxxxxxxxxx:password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:password@db.xxxxxxxxxxxx.supabase.co:5432/postgres"

# NextAuth - generate with: [Convert]::ToBase64String((1..32|%{[byte](Get-Random -Max 256)}))
NEXTAUTH_SECRET="your-secret-min-32-chars"
NEXTAUTH_URL="http://localhost:3000"
AUTH_SECRET="your-secret-min-32-chars"

# Google OAuth - console.cloud.google.com
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Paystack - dashboard.paystack.com > Settings > API Keys
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY="pk_test_xxxxxxxxxx"
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxx"
PAYSTACK_WEBHOOK_SECRET="your-webhook-secret"

# Cloudinary - cloudinary.com > Dashboard
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Resend - resend.com > API Keys
RESEND_API_KEY="re_xxxxxxxxxx"
RESEND_FROM_EMAIL="Élan Jewelry <hello@shopbyelan.com>"

# Brevo - app.brevo.com > SMTP & API > API Keys (list ID from Contacts > Lists)
BREVO_API_KEY="your-brevo-api-key"
BREVO_LIST_ID="your-brevo-list-id"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_WHATSAPP_NUMBER="2347079579907"
